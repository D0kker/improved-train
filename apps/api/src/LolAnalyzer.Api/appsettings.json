{
  "Cache": {
    "Provider": "memory",
    "Enabled": true,
    "MaxMemoryEntries": 4096,
    "MaxMemoryBytes": 67108864
  },
  "OnDemandAnalysis": {
    "RequestTimeoutSeconds": 180,
    "RequestConcurrency": 3
  },
  "ResourceProtection": {
    "ConcurrencyLimit": 8,
    "QueueLimit": 16,
    "QueueWaitMilliseconds": 5000,
    "ClientBurst": 20,
    "ClientRequestsPerMinute": 20,
    "MaxTrackedClients": 1024,
    "ClientIdleSeconds": 180
  },
  "Riot": {
    "PlatformRegion": "la1",
    "RegionalRouting": "americas",
    "RequestTimeoutSeconds": 10,
    "RequestConcurrency": 3,
    "MaxRetryAttempts": 2,
    "BaseRetryDelayMilliseconds": 250,
    "MaxRetryDelaySeconds": 120,
    "ShortWindowRequests": 20,
    "ShortWindowSeconds": 1,
    "LongWindowRequests": 100,
    "LongWindowSeconds": 120
  },
  "RelationshipScore": {
    "MatchesTogetherWeight": 30,
    "RecentFrequencyWeight": 30,
    "ConsecutiveMatchesWeight": 20,
    "SameTeamWeight": 20,
    "MatchesTogetherForFullScore": 10,
    "ConsecutiveMatchesForFullScore": 5,
    "RecentMatchWindow": 20,
    "RecencyWindow": "90.00:00:00",
    "MediumThreshold": 25,
    "HighThreshold": 50,
    "VeryHighThreshold": 75
  },
  "PremadeDetection": {
    "PossibleMinimumMatchesTogether": 3,
    "PossibleMinimumSameTeamRatio": 0.6,
    "PossibleMinimumConfidence": "Medium",
    "LikelyMinimumMatchesTogether": 5,
    "LikelyMinimumSameTeamRatio": 0.8,
    "LikelyMinimumConfidence": "High"
  },
  "PremadeGroupDetection": {
    "MinimumGroupSize": 3,
    "MaximumGroupSize": 5,
    "MaximumCandidates": 30,
    "MaximumCombinations": 100000
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  }
}
