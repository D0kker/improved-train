{
  "ConnectionStrings": {
    "Postgres": "Host=localhost;Port=5432;Database=lol_analyzer;Username=lol"
  },
  "Database": {
    "ApplyMigrations": true
  },
  "Redis": {
    "Host": "localhost",
    "Port": 6379
  },
  "Riot": {
    "PlatformRegion": "la1",
    "RegionalRouting": "americas",
    "RequestTimeoutSeconds": 10,
    "RequestConcurrency": 3
  },
  "RelationshipScore": {
    "MatchesTogetherWeight": 30,
    "RecentFrequencyWeight": 30,
    "ConsecutiveMatchesWeight": 20,
    "SameTeamWeight": 20,
    "MatchesTogetherForFullScore": 10,
    "ConsecutiveMatchesForFullScore": 5,
    "RecentMatchWindow": 20,
    "RecencyWindow": "90.00:00:00",
    "MediumThreshold": 25,
    "HighThreshold": 50,
    "VeryHighThreshold": 75
  },
  "RelationshipAnalysis": {
    "ReadBatchSize": 200,
    "WriteBatchSize": 500
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  }
}
