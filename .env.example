# Riot: secret de runtime consumido solo por API/worker.
RIOT_API_KEY=
RIOT_PLATFORM_REGION=la1
RIOT_REGIONAL_ROUTING=americas

# PostgreSQL: reemplaza los valores vacíos únicamente en tu .env local.
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_DB=lol_analyzer
POSTGRES_USER=lol
POSTGRES_PASSWORD=

# Redis
REDIS_HOST=redis
REDIS_PORT=6379

# Límites operativos configurables; los valores finales se fijarán en Sprint 1.
RIOT_REQUEST_CONCURRENCY=3
RIOT_REQUEST_TIMEOUT_SECONDS=10
