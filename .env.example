# Riot: secret de runtime consumido solo por API/worker.
RIOT_API_KEY=
RIOT_PLATFORM_REGION=la1
RIOT_REGIONAL_ROUTING=americas

# PostgreSQL: valor local de arranque; reemplázalo antes de exponer el entorno.
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_DB=lol_analyzer
POSTGRES_USER=lol
POSTGRES_PASSWORD=change-me-local-only

# Redis
REDIS_HOST=redis
REDIS_PORT=6379

# Límites operativos configurables; los valores finales se fijarán en Sprint 1.
RIOT_REQUEST_CONCURRENCY=3
RIOT_REQUEST_TIMEOUT_SECONDS=10

# Único puerto de acceso humano publicado por Docker Compose.
WEB_PORT=38080
