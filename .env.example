# Riot: secret de runtime consumido solo por API/worker.
RIOT_API_KEY=
RIOT_PLATFORM_REGION=la1
RIOT_REGIONAL_ROUTING=americas

# Activos oficiales estáticos; no es un secreto. Actualizar tras verificar Data Dragon.
DATA_DRAGON_VERSION=16.17.1

# PostgreSQL: valor local de arranque; reemplázalo antes de exponer el entorno.
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_DB=lol_analyzer
POSTGRES_USER=lol
POSTGRES_PASSWORD=change-me-local-only

# Redis
REDIS_HOST=redis
REDIS_PORT=6379
CACHE_PLAYER_SUMMARY_TTL_SECONDS=300

# Límites operativos configurables; los valores finales se fijarán en Sprint 1.
RIOT_REQUEST_CONCURRENCY=3
RIOT_REQUEST_TIMEOUT_SECONDS=10
RIOT_MAX_RETRY_ATTEMPTS=2
RIOT_BASE_RETRY_DELAY_MILLISECONDS=250
RIOT_MAX_RETRY_DELAY_SECONDS=120

# Backpressure de la API propia; no sustituye el límite por cliente del proxy público.
API_CONCURRENCY_LIMIT=32
API_QUEUE_LIMIT=32

# Único puerto de acceso humano publicado por Docker Compose.
WEB_PORT=38080
